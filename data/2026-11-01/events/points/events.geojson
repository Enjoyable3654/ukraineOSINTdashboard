rail/status/2116733026143277234"],"orbat":[],"key":"geoconfirmed:8703ecaf-5a95-463f-adf4-812ffbc4eaf0"}],"possible_matches":[],"media":[{"url":"https://x.com/Exilenova_plus/status/2116717743357780219","platform":"x","id":"2116717743357780219","kind":"media","too_big":null,"ratio_pct":null,"from":"GeoConfirmed","found_by":"linked by the source"}]}},{"type":"Feature","geometry":{"type":"Point","coordinates":[32.70606,46.61714]},"properties":{"source":"events","source_name":"Events","id":"ev-f7d001c081","date":"2026-11-01","time_utc":"2026-11-01T11:13:32+00:00","category":"Other military","categories":["Other military"],"claim":"Russian MoD claims Russian combat engineers are clearing roads in Oleshky.","side":"Russia (official)","color":"#E00000","confidence":"medium","confidence_reason":"photo in the post","location":"place","precision":"settlement","place":"Oleshky (City, Khersonskyi raion, Khersonska)","claim_sources":["ru_mod"],"claims":[{"source":"ru_mod","source_name":"Ministry of Defence of Russia","kind":"official claim","category":"Other military","claim":"Russian MoD claims Russian combat engineers are clearing roads in Oleshky.","side":"Russia (official)","color":"#E00000","date":"2026-11-01","time_utc":"2026-11-01T11:13:32+00:00","coords":[32.70606,46.61714],"precision":"settlement","loc":"place","place":"Oleshky (City, Khersonskyi raion, Khersonska)","evidence":"photo in the post","link":"https://t.me/mod_russia/68686","sources":[],"post_text":"Успехи на передовой, порядок в тылу и забота о людях. Главное за неделю:\n▫️ Координация сил и гуманитарная миссия: Андрей Белоусов проверил группировку «Днепр», поручив нарастить эффективность ударных БПЛА. В Алешках введен «режим тишины»: саперы очищают дороги, организована доставка гуманитарной помощи и эвакуация людей. Для желающих выехать из города организован безопасный коридор.\n▫️ Контроль воздушных и морских рубежей: подводный крейсер «Генералиссимус Суворов» успешно запустил баллистическую ракету «Булава» из Охотского моря. Параллельно экипажи Ту-95мс при поддержке Су-35с выполнили плановый полет над Беринговым и Чукотским морями.\n🤝 Международное партнерство: замминистра обороны Василий Осьмаков провел продуктивные встречи с коллегами из Конго, Сомали, Мали и Мадагаскара, закрепив оборонное сотрудничество. Замглавы военного ведомства Алексей Криворучко принял участие в Совещании министров обороны стран АСЕАН.\n⚓️ Верность традициям: Главком ВМФ Александр Моисеев поздравил личный состав с Днем моряка-надводника и 330-летием флота, а также вручил Боевое знамя воссозданному училищу имени М.В. Фрунзе.\nАрмия и флот надежно обеспечивают безопасность страны по всем направлениям. Движемся вперед!\n#СобытияНедели\n🔹 Минобороны России","media_ratio_pct":145.695,"media_too_big":false,"key":"ru_mod:68686#0"}],"possible_matches":[],"media":[{"url":"https://t.me/mod_russia/68686","platform":"tg","id":"mod_russia/68686","kind":"photo","too_big":false,"ratio_pct":145.695,"from":"Ministry of Defence of Russia","found_by":"linked by the source"}]}}]}